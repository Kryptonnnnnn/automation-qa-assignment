        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Discord: Normal Digest",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Turn any failed branch into a readable alert instead of failing silently.\nconst e = $input.first().json.error || $input.first().json;\nconst reason = (e && (e.message || e.description)) || JSON.stringify(e);\nreturn [{ json: { message: '❌ **Morning Brief failed**\\n' + reason + '\\nTime: ' + new Date().toISOString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Format Error"
    },
