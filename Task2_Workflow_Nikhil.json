{
  "name": "Task2_MorningBrief",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Every hour"
    },
    {
      "parameters": {
        "url": "https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=50&page=1&sparkline=false",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        0
      ],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Fetch Markets (CoinGecko)",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Keep coins that have a usable 24h change, sort best-first, keep the top 5.\nconst coins = $input.all().map(i => i.json)\n  .filter(c => c && typeof c.price_change_percentage_24h === 'number');\nif (!coins.length) throw new Error('CoinGecko returned no usable coins');\nconst top5 = coins\n  .sort((a, b) => b.price_change_percentage_24h - a.price_change_percentage_24h)\n  .slice(0, 5)\n  .map(c => ({\n    id: c.id,\n    name: c.name,\n    symbol: String(c.symbol).toUpperCase(),\n    price: c.current_price,\n    change24h: Number(c.price_change_percentage_24h.toFixed(2)),\n  }));\nreturn [{ json: { top5, top: top5[0], topChange: top5[0].change24h } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -100
      ],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Top 5 Gainers",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.coingecko.com/api/v3/coins/{{ $json.top.id }}/market_chart?vs_currency=usd&days=1",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        660,
        -100
      ],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Enrich: 24h Chart (CoinGecko)",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Build the digest. The chart enrichment is optional: if it failed we still send the digest.\nconst base = $('Top 5 Gainers').first().json;\nconst enr = $input.first().json;\nlet chartLine = '24h chart: unavailable (enrichment call failed)';\nif (Array.isArray(enr.prices) && enr.prices.length) {\n  const p = enr.prices.map(x => x[1]);\n  const fmt = n => n.toLocaleString('en-US', { maximumFractionDigits: 2 });\n  chartLine = '24h range: $' + fmt(Math.min(...p)) + ' - $' + fmt(Math.max(...p)) + ' (' + p.length + ' data points)';\n}\nconst lines = base.top5.map((c, i) =>\n  (i + 1) + '. ' + c.name + ' (' + c.symbol + ') $' + c.price.toLocaleString('en-US', { maximumSignificantDigits: 4 }) +\n  ' | ' + (c.change24h >= 0 ? '+' : '') + c.change24h + '%');\nconst message = '📰 **Morning Brief - top 5 movers (24h)**\\n' + lines.join('\\n') +\n  '\\n\\n🔎 **' + base.top.name + '** ' + chartLine;\nreturn [{ json: { message, topChange: base.topChange } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Build Digest"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "b1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.topChange }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        -100
      ],
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Top gainer > 5%?"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ '🚀 **Hot move (top gainer > 5%)**\\n' + $json.message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1320,
        -200
      ],
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Discord: Hot Alert",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
