{
  "name": "Bonus_UptimeMonitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1000000-0000-4000-8000-000000000001",
              "name": "t0",
              "value": "={{ Date.now() }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        0
      ],
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Start Timer"
    },
    {
      "parameters": {
        "url": "https://todomvc.com/examples/react/dist/",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        400,
        0
      ],
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Ping App",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Evaluate the ping: status code + response time, and update the running daily stats.\nconst t0 = $('Start Timer').first().json.t0;\nconst r = $input.first().json;\nconst statusCode = Number(r.statusCode) || 0;          // 0 = no response (DNS/timeout)\nconst responseMs = Date.now() - t0;\nconst sd = $getWorkflowStaticData('global');\nsd.checks = (sd.checks || 0) + 1;\nsd.totalMs = (sd.totalMs || 0) + responseMs;\nsd.maxMs = Math.max(sd.maxMs || 0, responseMs);\nif (statusCode !== 200) sd.nonOk = (sd.nonOk || 0) + 1;\nreturn [{ json: { statusCode, responseMs, ok: statusCode === 200 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Evaluate"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000005-c",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        800,
        0
      ],
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Status 200?"
    },
    {
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1000,
        120
      ],
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Wait 15s (retry)",
      "webhookId": "e1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "url": "https://todomvc.com/examples/react/dist/",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1200,
        120
      ],
      "id": "c1000000-0000-4000-8000-000000000007",
      "name": "Re-check App",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Second opinion after the wait. Only a repeated failure is treated as an outage.\nconst r = $input.first().json;\nconst statusCode = Number(r.statusCode) || 0;\nconst ok = statusCode === 200;\nconst sd = $getWorkflowStaticData('global');\nif (!ok) sd.outages = (sd.outages || 0) + 1;\nconst message = '🚨 **App DOWN** - https://todomvc.com/examples/react/dist/\\n' +\n  'HTTP status: ' + (statusCode || 'no response / timeout') + ' (confirmed on retry)\\n' +\n  'Time: ' + new Date().toISOString();\nreturn [{ json: { statusCode, ok, message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        120
      ],
      "id": "c1000000-0000-4000-8000-000000000008",
      "name": "Evaluate Retry"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000009-c",
              "leftValue": "={{ !$json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1600,
        120
      ],
      "id": "c1000000-0000-4000-8000-000000000009",
      "name": "Still down?"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1800,
        60
      ],
      "id": "c1000000-0000-4000-8000-000000000010",
      "name": "Discord: Down Alert",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        360
      ],
      "id": "c1000000-0000-4000-8000-000000000011",
      "name": "Daily 09:00"
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst checks = sd.checks || 0;\nconst avg = checks ? Math.round((sd.totalMs || 0) / checks) : 0;\nconst upPct = checks ? (((checks - (sd.nonOk || 0)) / checks) * 100).toFixed(2) : 'n/a';\nconst message = '📊 **Daily uptime summary**\\nChecks: ' + checks + '\\nAvailability (first-try 200s): ' + upPct + '%' +\n  '\\nConfirmed outages: ' + (sd.outages || 0) + '\\nAvg response: ' + avg + ' ms | Slowest: ' + (sd.maxMs || 0) + ' ms';\nsd.checks = 0; sd.totalMs = 0; sd.maxMs = 0; sd.nonOk = 0; sd.outages = 0;   // reset for the next day\nreturn [{ json: { message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        360
      ],
      "id": "c1000000-0000-4000-8000-000000000012",
      "name": "Build Daily Summary"
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "={{ $json.message }}",
        "options": {}
      },
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        600,
        360
      ],
      "id": "c1000000-0000-4000-8000-000000000013",
      "name": "Discord: Daily Summary",
      "credentials": {
        "discordWebhookApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
